<% content_for :page_title, title_with_error_prefix(
  t(".title"),
  error: current_step.errors.any?,
) %>

<%= form_for(current_step, url: current_step_path, method: :put) do |f| %>
  <%= f.govuk_error_summary %>

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <span class="govuk-caption-l">
        <%= t(".caption", academic_year_name: wizard.academic_year.short_name) %>
      </span>

      <h1 class="govuk-heading-l"><%= t(".title") %></h1>

      <div class="govuk-hint" id="note-to-providers-hint">
        <p class="govuk-!-margin-bottom-2"><%= t(".hint_intro") %></p>
        <ul class="govuk-list govuk-list--bullet">
          <li><%= t(".hint_item_1") %></li>
          <li><%= t(".hint_item_2") %></li>
        </ul>
      </div>

      <%= f.govuk_text_area :note,
          label: { text: t(".title"), hidden: true } %>

      <%= f.govuk_submit t(".continue") %>
    </div>
  </div>
<% end %>
